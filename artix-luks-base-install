#!/usr/bin/env bash
# ALBI: minimal encrypted Artix installation (UEFI + runit)
# WARNING: erases the selected disk. Run from an Artix live USB as root.
set -euo pipefail

# Check the live installer before changing anything.
[[ $EUID == 0 ]] || { echo 'Run as root.'; exit 1; }
[[ -d /sys/firmware/efi/efivars ]] || { echo 'Boot the USB in UEFI mode.'; exit 1; }
for tool in basestrap artix-chroot fstabgen lsblk; do
    command -v "$tool" >/dev/null || { echo "Missing $tool"; exit 1; }
done
mountpoint -q /mnt && { echo 'Unmount /mnt before starting.'; exit 1; }

# Original ALBI menu. Passwords are hidden rather than printed on screen.
username=artix
disk=/dev/nvme0n1
hostname=artix
vg=VGArtix
encryption_password=''
root_password=''
user_password=''

red=$'\033[0;31m'
green=$'\033[0;32m'
normal=$'\033[0m'

ask_password() {
    local question="$1" variable="$2" first second
    read -rsp "$question " first; echo
    read -rsp 'Confirm password: ' second; echo
    if [[ -z $first || $first == changeme || $first != "$second" ]]; then
        echo 'Passwords do not match, are empty, or use changeme. Try again.'
        return 1
    fi
    printf -v "$variable" '%s' "$first"
}

while true; do
    clear -x 2>/dev/null || true
    echo '################################################'
    echo '# Welcome to this Artix Installation Script. #'
    echo '# Select the values you want to modify: #'
    [[ -n $encryption_password ]] && a="${green}< CHANGED${normal}" || a="${red}< CHANGE THIS${normal}"
    [[ -n $root_password ]] && b="${green}< CHANGED${normal}" || b="${red}< CHANGE THIS${normal}"
    [[ -n $user_password ]] && c="${green}< CHANGED${normal}" || c="${red}< CHANGE THIS${normal}"
    printf '0) Change the encryption password: %b\n' "$a"
    printf '1) Change the root password: %b\n' "$b"
    printf '2) Change the user password: %b\n' "$c"
    printf "3) Change the user name: '%s'\n" "$username"
    printf "4) Change the disk name: '%s'\n" "$disk"
    printf "5) Change the host name: '%s'\n" "$hostname"
    printf "6) Change the volume group name: '%s'\n" "$vg"
    echo 'GO) Execute script using above listed variables'
    echo 'q) EXIT installation'
    read -rp '> ' choice
    case $choice in
        0) ask_password 'Enter the new encryption password:' encryption_password || true ;;
        1) ask_password 'Enter the new root password:' root_password || true ;;
        2) ask_password 'Enter the user password:' user_password || true ;;
        3) read -rp 'Enter the user name: ' username ;;
        4) lsblk -e7 -o NAME,PATH,SIZE,TYPE,MODEL; read -rp 'Enter the disk name: ' disk ;;
        5) read -rp 'Enter the host name: ' hostname ;;
        6) read -rp 'Enter the volume group name: ' vg ;;
        GO|go) break ;;
        q|Q) exit 0 ;;
    esac
done

# Check all values before erasing anything.
[[ -n $encryption_password && -n $root_password && -n $user_password ]] || {
    echo 'Set all three passwords (menu options 0, 1, and 2).'; exit 1;
}
[[ -b $disk && $(lsblk -dnro TYPE "$disk") == disk ]] || { echo 'Select a whole disk.'; exit 1; }
[[ $username =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo 'Invalid username.'; exit 1; }
[[ $hostname =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]] || { echo 'Invalid hostname.'; exit 1; }
[[ $vg =~ ^[a-zA-Z][a-zA-Z0-9_.+-]*$ ]] || { echo 'Invalid volume group name.'; exit 1; }
[[ ! -e /dev/mapper/cryptlvm ]] || { echo 'cryptlvm is already in use.'; exit 1; }
if lsblk -nr -o MOUNTPOINTS "$disk" | grep -q '[^[:space:]]'; then
    echo 'That disk has mounted filesystems. Unmount them first.'; exit 1
fi
read -rp 'Are you sure?, no going back after this (y/n): ' verify
[[ $verify == [Yy]* ]] || exit 0
printf '\nALL DATA ON %s WILL BE LOST.\n' "$disk"
read -rp "Type 'ERASE $disk' to continue: " answer
[[ $answer == "ERASE $disk" ]] || exit 0

# Install the disk tools in the live environment.
pacman -Sy --needed --noconfirm parted dosfstools cryptsetup lvm2
if vgs "$vg" >/dev/null 2>&1; then
    echo "$vg already exists."; exit 1
fi
printf '\nStarting Artix Linux installation...\n'

# SATA disks use /dev/sda1; NVMe disks use /dev/nvme0n1p1.
partition() {
    if [[ $disk == *[0-9] ]]; then printf '%sp%s' "$disk" "$1"
    else printf '%s%s' "$disk" "$1"; fi
}
boot=$(partition 1)
encrypted=$(partition 2)

# One EFI partition; the rest is LUKS -> LVM -> swap + ext4 root.
parted -s "$disk" mklabel gpt
parted -s "$disk" mkpart ESP fat32 1MiB 513MiB
parted -s "$disk" set 1 esp on
parted -s "$disk" mkpart encrypted 513MiB 100%
partprobe "$disk"
udevadm settle

# Supply the password through standard input, never command-line arguments.
printf '%s' "$encryption_password" | cryptsetup luksFormat --type luks2 --key-file - "$encrypted"
printf '%s' "$encryption_password" | cryptsetup open --key-file - "$encrypted" cryptlvm
unset encryption_password
pvcreate /dev/mapper/cryptlvm
vgcreate "$vg" /dev/mapper/cryptlvm
lvcreate -L 8G -n swap "$vg"
lvcreate -l 100%FREE -n root "$vg"

mkfs.fat -F32 "$boot"
mkfs.ext4 -F "/dev/$vg/root"
mkswap "/dev/$vg/swap"
mount "/dev/$vg/root" /mnt
mkdir -p /mnt/boot
mount "$boot" /mnt/boot
swapon "/dev/$vg/swap"

# Install the base system and tools for the post-reboot chezmoi setup.
basestrap /mnt base base-devel runit elogind-runit linux linux-firmware \
    networkmanager networkmanager-runit dbus dbus-runit \
    cryptsetup lvm2 mkinitcpio grub efibootmgr sudo git gnupg openssh python zsh
fstabgen -U /mnt > /mnt/etc/fstab

# Install chezmoi now if the enabled repositories provide it.
if pacman -Si chezmoi >/dev/null 2>&1; then
    basestrap /mnt chezmoi
else
    echo 'chezmoi is not in the enabled repositories; install it after reboot.'
fi

# Locale, clock, hostname, and sudo access.
ln -sf /usr/share/zoneinfo/America/Los_Angeles /mnt/etc/localtime
artix-chroot /mnt hwclock --systohc
sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /mnt/etc/locale.gen
artix-chroot /mnt locale-gen
echo 'LANG=en_US.UTF-8' > /mnt/etc/locale.conf
echo "$hostname" > /mnt/etc/hostname
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' \
    "$hostname" "$hostname" > /mnt/etc/hosts
mkdir -p /mnt/etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /mnt/etc/sudoers.d/10-wheel
chmod 440 /mnt/etc/sudoers.d/10-wheel
artix-chroot /mnt visudo -cf /etc/sudoers

# Apply the passwords chosen in the installation menu.
artix-chroot /mnt useradd -m -G wheel -s /bin/zsh "$username"
printf 'root:%s\n' "$root_password" | artix-chroot /mnt chpasswd
printf '%s:%s\n' "$username" "$user_password" | artix-chroot /mnt chpasswd
unset root_password user_password

# Enable networking for the first boot.
mkdir -p /mnt/etc/runit/runsvdir/default
for service in dbus NetworkManager; do
    ln -sfn "/etc/runit/sv/$service" "/mnt/etc/runit/runsvdir/default/$service"
done

# Unlock the root disk before activating LVM during early boot.
sed -i '/^HOOKS=/c\HOOKS=(base udev autodetect modconf kms keyboard keymap block encrypt lvm2 resume filesystems fsck)' \
    /mnt/etc/mkinitcpio.conf
uuid=$(blkid -s UUID -o value "$encrypted")
sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"cryptdevice=UUID=$uuid:cryptlvm resume=/dev/$vg/swap\"|" \
    /mnt/etc/default/grub
artix-chroot /mnt mkinitcpio -P
artix-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=Artix
artix-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg

# Leave a clean, bootable installation. No dotfiles applied yet.
swapoff "/dev/$vg/swap"
umount -R /mnt
vgchange -an "$vg"
cryptsetup close cryptlvm
printf '\nInstalled Artix. Reboot, sign in as %s, then initialize chezmoi.\n' "$username"
